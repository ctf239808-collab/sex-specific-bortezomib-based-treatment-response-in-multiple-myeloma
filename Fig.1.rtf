\f0  HD / MM / OR / SOR 
\f1 \'d6\'d0\'d7\'f6\'d0\'d4\'b1\'f0\'b2\'ee\'d2\'ec\'a3\'a8\'b6\'e0\'b2\'e3\'b6\'d4\'b1\'c8\'a3\'a9
\f0 \
sex_fc_by_group <- function(meta, group_filter = NULL, label = "") \{\
  \
  df <- meta\
  if (!is.null(group_filter)) \{\
    df <- dplyr::filter(df, !!rlang::parse_expr(group_filter))\
  \}\
  \
  cell_prop <- df %>%\
    dplyr::count(orig.ident, anno, name = "n_cells") %>%\
    dplyr::group_by(orig.ident) %>%\
    dplyr::mutate(prop = n_cells / sum(n_cells)) %>%\
    dplyr::ungroup() %>%\
    dplyr::left_join(\
      df %>% dplyr::select(orig.ident, gender) %>% distinct(),\
      by = "orig.ident"\
    )\
  \
  fc_df <- cell_prop %>%\
    dplyr::group_by(anno, gender) %>%\
    dplyr::summarise(mean_prop = mean(prop), .groups = "drop") %>%\
    tidyr::pivot_wider(\
      names_from = gender,\
      values_from = mean_prop,\
      values_fill = 1e-6\
    ) %>%\
    dplyr::mutate(\
      log2FC = log2(Male / Female),\
      group = label\
    )\
  \
  return(fc_df)\
\}\
\
fc_HD  <- sex_fc_by_group(meta, "group == 'HD'",  "HD")\
fc_MM  <- sex_fc_by_group(meta, "group == 'MM'",  "MM")\
fc_OR  <- sex_fc_by_group(meta, "group == 'MM' & group.a == 'OR'",  "MM_OR")\
fc_SOR <- sex_fc_by_group(meta, "group == 'MM' & group.a == 'SOR'", "MM_SOR")\
\
fc_all <- dplyr::bind_rows(fc_HD, fc_MM, fc_OR, fc_SOR)\
\
ggplot(fc_all, aes(x = group, y = anno, fill = log2FC)) +\
  geom_tile(color = "white") +\
  scale_fill_gradient2(\
    low = "#4E79A7",\
    mid = "white",\
    high = "#E15759",\
    limits = c(-2, 2),\
    oob = scales::squish\
  ) +\
  scale_y_discrete(limits = rev(names(celltype_colors))) +\
  theme_classic(base_size = 12) +\
  theme(\
    axis.text.x = element_text(angle = 45, hjust = 1)\
  ) +\
  labs(\
    fill = "log2FC\\n(Male/Female)",\
    x = NULL,\
    y = NULL\
  )\
